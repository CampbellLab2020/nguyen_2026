prmtop=../prmtop/a5b1_mint-strip.prmtop

for i in ../strip-traj/*mint*xtc; do \
traj=${i##*/}
get_dynamic_contacts.py --topology ${prmtop} --trajectory ${i} --itypes sb pc ps ts hb --sele "resid 1 to 450" --sele2 "resid 698 to 933" --output ${traj/.xtc/-contacts.tsv} --end 20000 --cores 16

get_contact_frequencies.py --input_files ${traj/.xtc/-contacts.tsv} --output_file ${traj/.xtc/-freq.tsv};
done

